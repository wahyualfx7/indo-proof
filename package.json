{
  "name": "indo-proof",
  "version": "0.1.0",
  "description": "Offline document integrity and trusted Ed25519 signatures, with optional EVM anchoring for Indonesia-focused apps",
  "keywords": [
    "indonesia",
    "document",
    "integrity",
    "signature",
    "ed25519",
    "sha256",
    "blockchain",
    "verification"
  ],
  "license": "MIT",
  "author": "IndoProof contributors",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./blockchain": {
      "types": "./blockchain.d.ts",
      "import": "./blockchain.mjs",
      "require": "./blockchain.cjs"
    }
  },
  "bin": {
    "indoproof": "./bin/indoproof.cjs"
  },
  "files": [
    "src/",
    "bin/",
    "contracts/",
    "examples/",
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "blockchain.cjs",
    "blockchain.mjs",
    "blockchain.d.ts",
    "README.md",
    "LICENSE",
    "README.id.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "example": "node examples/basic.cjs",
    "example:chain": "node examples/blockchain.cjs",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahyualfx7/indo-proof.git"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
